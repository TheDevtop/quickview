<!doctype html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{title}} · Quickview</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&family=Roboto+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons|Material+Icons+Outlined">
<link rel="stylesheet" href="/static/cloud-console.css">
<link rel="stylesheet" href="/static/app.css">
<script src="/static/cloud-console.js" defer></script>
<script src="/static/app.js" defer></script>
</head>
<body>
<header data-topbar>
	<a class="brand" href="/"><span class="material-icons">table_view</span>Quickview</a>
	{{#if base}}
	<div class="cc-row">
		<span class="addr" title="Quicktable server"><span class="material-icons-outlined">dns</span><span>{{base}}</span></span>
		<form method="post" action="/disconnect">
			<button type="submit" class="ghost" aria-label="Disconnect"><span class="material-icons">logout</span><span class="wide">Disconnect</span></button>
		</form>
	</div>
	{{/if}}
</header>
{{#if base}}
<header data-subheader>
	<div class="product-title"><span class="material-icons-outlined">storage</span>Quicktable</div>
	<div class="subheader-bar">{{{sections.bar}}}</div>
</header>
{{/if}}
<div class="cc-shell{{#unless base}} bare{{/unless}}">
	{{#if base}}
	<aside data-sidebar>
		<div class="explorer-head">
			<h2>Explorer</h2>
			<a role="button" class="ghost" href="/new"><span class="material-icons">add</span>Add</a>
		</div>
		<div role="search" class="explorer-search">
			<span class="material-icons">search</span>
			<input type="search" placeholder="Search for tables" aria-label="Search for tables" data-filter="tables">
		</div>
		<details data-tree open>
			<summary><span class="material-icons-outlined">dns</span><span class="trunc">{{base}}</span></summary>
			<ul class="tree" id="tables">
				{{#each tables}}
				<li><a class="tree-leaf" href="/tables/{{u this}}"{{#if (eq this ../table)}} aria-selected="true"{{/if}}><span class="material-icons-outlined">table_chart</span><span class="trunc">{{this}}</span></a></li>
				{{else}}
				<li><small class="empty">No tables</small></li>
				{{/each}}
			</ul>
		</details>
	</aside>
	{{/if}}
	<main data-workspace>
		{{#if base}}
		<div data-workspace-tabbar>
			<div class="tab-scroll-list">
				<a class="ws-tab" aria-selected="true" href="{{#if table}}/tables/{{u table}}{{else}}#{{/if}}"><span class="material-icons-outlined">{{#if icon}}{{icon}}{{else}}table_chart{{/if}}</span><span class="trunc">{{title}}</span></a>
			</div>
			<a class="compose" href="/editor{{#if table}}?table={{u table}}{{/if}}"><span class="material-icons">add</span>Compose new query</a>
		</div>
		{{/if}}
		{{{sections.tabs}}}
		<div class="page">
			{{#if connerr}}<div role="alert" data-variant="danger"><span class="material-icons">error</span>{{connerr}}</div>{{/if}}
			{{#if err}}<div role="alert" data-variant="danger"><span class="material-icons">error</span>{{err}}</div>{{/if}}
			{{#if msg}}<div role="alert" data-variant="success"><span class="material-icons">check_circle</span>{{msg}}</div>{{/if}}
			{{{body}}}
		</div>
	</main>
</div>
</body>
</html>
