{{#section 'bar'}}
<nav aria-label="Breadcrumb"><ul>
	<li><a href="/">Tables</a></li>
	<li><a href="/tables/{{u table}}" class="breadcrumb-stack"><small>Table</small>{{table}}</a></li>
	<li><a href="{{rowhref}}" class="breadcrumb-stack"><small>Row</small>{{key}}</a></li>
	<li><span class="breadcrumb-stack"><small>Column</small>{{column}}</span></li>
</ul></nav>
<form method="post" action="{{rowhref}}/columns/{{u column}}/delete">
	<button type="submit" class="danger"><span class="material-icons-outlined">delete</span>Delete cell</button>
</form>
{{/section}}

<article>
	<header><h3>Value</h3><span data-pill>{{type}}</span></header>
	<pre><code>{{v}}</code></pre>
</article>

<article>
	<header><h3>Set cell</h3></header>
	<form method="post" action="{{rowhref}}/columns/{{u column}}">
		<div class="cell-row">
			<textarea name="value" rows="3" aria-label="Value">{{v}}</textarea>
			{{> typesel n="type" t=type}}
		</div>
		<footer><button type="submit"><span class="material-icons">save</span>Save</button></footer>
	</form>
</article>
