<nav aria-label="Breadcrumb"><ul><li><a href="/">Tables</a></li><li><a href="/tables/{{u table}}">{{table}}</a></li><li><a href="{{rowhref}}">{{key}}</a></li><li>{{column}}</li></ul></nav>
<div class="toolbar">
	<h1>{{column}} <span data-badge>{{type}}</span></h1>
	<form method="post" action="{{rowhref}}/columns/{{u column}}/delete">
		<button type="submit" class="danger">Delete cell</button>
	</form>
</div>

<article>
	<header><h3>Value</h3></header>
	<pre><code>{{v}}</code></pre>
</article>

<article>
	<header><h3>Set cell</h3></header>
	<form method="post" action="{{rowhref}}/columns/{{u column}}">
		<div class="cell-row">
			<textarea name="value" rows="3" aria-label="Value">{{v}}</textarea>
			{{> typesel n="type" t=type}}
		</div>
		<footer><button type="submit">Save</button></footer>
	</form>
</article>
