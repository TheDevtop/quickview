<div class="toolbar">
	<h1>Explorer</h1>
	<a role="button" href="/new">+ Create table</a>
</div>

<div class="table-scroll">
<table>
	<thead><tr><th>Table</th></tr></thead>
	<tbody>
		{{#each tables}}
		<tr><td><a href="/tables/{{u this}}">▦ {{this}}</a></td></tr>
		{{else}}
		<tr><td class="missing">No tables yet</td></tr>
		{{/each}}
	</tbody>
</table>
</div>
