{{#section 'bar'}}
<nav aria-label="Breadcrumb"><ul><li><h1>Tables</h1></li></ul></nav>
<a role="button" class="ghost" href="/new"><span class="material-icons">add</span>Create table</a>
{{/section}}

<div class="panel">
<div class="table-wrap">
<table data-grid="clean">
	<thead><tr><th>Name <small>({{tables.length}})</small></th></tr></thead>
	<tbody>
		{{#each tables}}
		<tr><td><a href="/tables/{{u this}}" class="named"><span class="material-icons-outlined">table_chart</span>{{this}}</a></td></tr>
		{{else}}
		<tr><td class="missing">No tables yet. <a href="/new">Create the first one</a>; a table exists once it holds a cell.</td></tr>
		{{/each}}
	</tbody>
</table>
</div>
</div>
