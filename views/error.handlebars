{{#section 'bar'}}
<nav aria-label="Breadcrumb"><ul><li><a href="/">Explorer</a></li>{{#if table}}<li><a href="/tables/{{u table}}">{{table}}</a></li>{{/if}}<li>{{status}} {{reason}}</li></ul></nav>
{{/section}}

<article class="narrow">
	<header><h3>{{status}} {{reason}}</h3><span data-pill data-badge="danger">Error</span></header>
	<p>{{text}}</p>
	<footer>
		{{#if table}}<a role="button" class="secondary" href="/tables/{{u table}}"><span class="material-icons">arrow_back</span>Back to {{table}}</a>{{/if}}
		<a role="button" class="{{#if table}}ghost{{else}}secondary{{/if}}" href="/">Explorer</a>
	</footer>
</article>
