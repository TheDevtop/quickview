{{#section 'bar'}}
<nav aria-label="Breadcrumb"><ul><li><a href="/">Tables</a></li><li>Create table</li></ul></nav>
{{/section}}

<article class="narrow">
	<header><h3>Create table</h3><small>A table exists while it holds at least one cell</small></header>
	<form method="post" action="/tables">
		<label for="table">Table name</label>
		<input id="table" name="table" required placeholder="users" autofocus>
		<h5 class="gap">First row</h5>
		{{> cols list=cols n="cols"}}
		<footer><button type="submit"><span class="material-icons">add</span>Create table</button></footer>
	</form>
</article>
