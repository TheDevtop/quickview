{{#section 'bar'}}
<nav aria-label="Breadcrumb"><ul>
	<li><a href="/">Explorer</a></li>
	<li><span class="breadcrumb-stack"><small>Table</small>{{table}}</span></li>
</ul></nav>
<span class="cc-row">
	<form method="get" action="{{href}}/goto" class="goto">
		<input type="hidden" name="tab" value="{{tab}}">
		<input name="key" placeholder="Go to row key" aria-label="Row key" required>
		<button type="submit" class="icon" aria-label="Go to row"><span class="material-icons">arrow_forward</span></button>
	</form>
	<a role="button" class="ghost" href="/editor?table={{u table}}"><span class="material-icons-outlined">search</span>Query</a>
	<a role="button" class="ghost" href="{{href}}?tab=insert"><span class="material-icons">add</span>Insert row</a>
	<a role="button" class="ghost" href="{{href}}?tab={{tab}}"><span class="material-icons">refresh</span>Refresh</a>
</span>
{{/section}}

{{#section 'tabs'}}
<nav role="tablist" aria-label="Table views">
	{{#each tabs}}
	<a role="tab" href="{{../href}}?tab={{id}}" aria-selected="{{eq id ../tab}}">{{label}}</a>
	{{/each}}
</nav>
{{/section}}

{{#if colnames}}<datalist id="colnames">{{#each colnames}}<option value="{{this}}">{{/each}}</datalist>{{/if}}

{{#if (eq tab 'details')}}
<article>
	<header><h3>Table info</h3></header>
	<dl class="info">
		<dt>Table ID</dt><dd><code>{{table}}</code></dd>
		<dt>Server</dt><dd><code>{{base}}</code></dd>
		<dt>Number of rows</dt><dd>{{count}}</dd>
		<dt>First row key</dt><dd>{{#if firstkey}}<a href="{{href}}/rows/{{u firstkey}}"><code>{{firstkey}}</code></a>{{else}}<span class="missing">none</span>{{/if}}</dd>
		<dt>Last row key</dt><dd>{{#if lastkey}}<a href="{{href}}/rows/{{u lastkey}}"><code>{{lastkey}}</code></a>{{else}}<span class="missing">none</span>{{/if}}</dd>
	</dl>
</article>
<article>
	<header><h3>Delete table</h3><span data-pill data-badge="danger">Cannot be undone</span></header>
	<p>Permanently removes <strong>{{table}}</strong> and all of its rows. Type the table name to confirm.</p>
	<form method="post" action="{{href}}/drop">
		<input name="confirm" placeholder="{{table}}" aria-label="Confirm table name" required>
		<footer><button type="submit" class="danger"><span class="material-icons-outlined">delete_forever</span>Delete table</button></footer>
	</form>
</article>
{{/if}}

{{#if (eq tab 'preview')}}
<div class="panel">
	{{> grid grid}}
	<div class="cc-pagination">
		<span>{{#if first}}Keys <code>{{first}}</code> – <code>{{last}}</code> · {{/if}}{{total}} rows</span>
		<a role="button" class="icon"{{#if hasprev}} href="{{href}}?tab=preview{{#if prev}}&from={{u prev}}{{/if}}"{{else}} aria-disabled="true"{{/if}} aria-label="Previous page"><span class="material-icons">chevron_left</span></a>
		<a role="button" class="icon"{{#if next}} href="{{href}}?tab=preview&from={{u next}}"{{else}} aria-disabled="true"{{/if}} aria-label="Next page"><span class="material-icons">chevron_right</span></a>
	</div>
</div>
{{/if}}

{{#if (eq tab 'keys')}}
<article>
	<header><h3>Row keys</h3><small>{{keys.length}} rows</small></header>
	<ul class="keys">
		{{#each keys}}<li><a href="{{../href}}/rows/{{u this}}"><code>{{this}}</code></a></li>{{else}}<li class="missing">No rows</li>{{/each}}
	</ul>
</article>
{{/if}}

{{#if (eq tab 'query')}}
<article>
	<header><h3>Query builder</h3><small>Builds a <code>POST /api/query</code> request</small></header>
	<form method="post" action="{{href}}/query">
		{{> filters}}
		<h5 class="gap">Result</h5>
		<div class="fields">
			<div><label>Select columns</label><input name="select" value="{{form.select}}" placeholder="all; or name, age"></div>
			<div><label>Aggregate</label>
				<select name="agg"><option value="">none — return rows</option>{{#each aggs}}<option{{#if (eq this ../form.agg)}} selected{{/if}}>{{this}}</option>{{/each}}</select>
			</div>
			<div><label>Aggregate column</label><input name="column" value="{{form.column}}" placeholder="for sum, avg, min, max" list="colnames"></div>
		</div>
		<footer>
			<button type="submit" name="do" value="editor" class="secondary"><span class="material-icons">code</span>Open in editor</button>
			<button type="submit" name="do" value="run"><span class="material-icons">play_arrow</span>Run</button>
		</footer>
	</form>
</article>
{{#if r}}{{> results r=r}}{{/if}}
{{/if}}

{{#if (eq tab 'insert')}}
<article>
	<header><h3>Insert row</h3><small>Writing to an existing key merges into that row</small></header>
	<form method="post" action="{{href}}/rows">
		<label for="key">Row key</label>
		<input id="key" name="key" required placeholder="ann" pattern="\S+" title="No whitespace">
		<h5 class="gap">Columns</h5>
		{{> cols list=cols n="cols"}}
		<footer><button type="submit"><span class="material-icons">add</span>Insert</button></footer>
	</form>
</article>
<article>
	<header><h3>Batch insert</h3><small>One atomic batch; values keep their JSON types</small></header>
	<form method="post" action="{{href}}/batch">
		<label for="rows">Rows — JSON object of row key to columns</label>
		<textarea id="rows" name="rows" rows="6" required placeholder='{
  "ann": { "age": 32, "name": "Ann" },
  "bob": { "age": 41 }
}'></textarea>
		<footer><button type="submit"><span class="material-icons">playlist_add</span>Insert rows</button></footer>
	</form>
</article>
{{/if}}

{{#if (eq tab 'delete')}}
<article>
	<header><h3>Delete row</h3><span data-pill data-badge="danger">Cannot be undone</span></header>
	<form method="post" action="{{href}}/delete" data-confirm="Delete this row from {{table}}?">
		<label for="delkey">Row key</label>
		<input id="delkey" name="key" required placeholder="ann" pattern="\S+" title="No whitespace">
		<footer><button type="submit" class="danger"><span class="material-icons-outlined">delete</span>Delete</button></footer>
	</form>
</article>
<article>
	<header><h3>Batch delete</h3><span data-pill data-badge="danger">Cannot be undone</span></header>
	<form method="post" action="{{href}}/delete" data-confirm="Delete these rows from {{table}}?">
		<label for="delkeys">Row keys — JSON array of strings</label>
		<textarea id="delkeys" name="keys" rows="4" required placeholder='["ann", "bob", "carol"]'></textarea>
		<footer><button type="submit" class="danger"><span class="material-icons-outlined">delete_sweep</span>Delete rows</button></footer>
	</form>
</article>
{{/if}}
