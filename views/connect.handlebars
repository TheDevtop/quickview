<article class="connect">
	<header><h3>Connect to Quicktable</h3></header>
	<form method="post" action="/connect">
		<label for="url">Server address</label>
		<input id="url" name="url" value="{{url}}" placeholder="http://localhost:8080" required autofocus>
		<footer><button type="submit">Connect</button></footer>
	</form>
</article>
