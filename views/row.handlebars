{{#section 'bar'}}
<nav aria-label="Breadcrumb"><ul>
	<li><a href="/">Explorer</a></li>
	<li><a href="/tables/{{u table}}" class="breadcrumb-stack"><small>Table</small>{{table}}</a></li>
	<li><span class="breadcrumb-stack"><small>Row</small>{{key}}</span></li>
</ul></nav>
<form method="post" action="{{href}}/delete" data-confirm="Delete row {{key}}?">
	<button type="submit" class="danger"><span class="material-icons-outlined">delete</span>Delete row</button>
</form>
{{/section}}

<datalist id="colnames">{{#each list}}<option value="{{name}}">{{/each}}</datalist>

<div class="panel">
<div class="table-wrap">
<table>
	<thead><tr><th>Column</th><th>Value</th><th>Type</th><th></th></tr></thead>
	<tbody>
		{{#each list}}
		<tr>
			<td><a href="{{href}}"><code>{{name}}</code></a></td>
			<td class="value{{#if (eq type 'number')}} num{{/if}}">{{v}}</td>
			<td><span data-pill>{{type}}</span></td>
			<td class="num">
				<form method="post" action="{{href}}/delete"><button type="submit" class="icon" aria-label="Delete {{name}}" data-tooltip="Delete cell"><span class="material-icons-outlined">delete</span></button></form>
			</td>
		</tr>
		{{/each}}
	</tbody>
</table>
</div>
</div>

<div class="cc-grid gap">
	<article>
		<header><h3>Set columns</h3><small>Unmentioned columns are kept</small></header>
		<form method="post" action="{{href}}">
			{{> cols list=cols n="cols"}}
			<footer><button type="submit"><span class="material-icons">save</span>Write</button></footer>
		</form>
	</article>

	<article>
		<header><h3>Increment</h3><small>A missing cell counts as 0</small></header>
		<form method="post" action="{{href}}/incr">
			<div class="cell-row pair">
				<input name="column" placeholder="column" aria-label="Column" list="colnames" required>
				<input name="delta" placeholder="delta" aria-label="Delta" value="1" inputmode="decimal" required>
			</div>
			<footer><button type="submit"><span class="material-icons">exposure_plus_1</span>Increment</button></footer>
		</form>
	</article>
</div>

<article>
	<header><h3>Conditional write</h3><small>One batch: nothing is written unless the condition holds</small></header>
	<form method="post" action="{{href}}/cond">
		<h5>If</h5>
		<div class="pred-row">
			<input name="column" placeholder="column" aria-label="Condition column" list="colnames" required>
			{{> cmpsel n="cmp" o="="}}
			<input name="value" placeholder="value" aria-label="Condition value">
			{{> typesel n="type" t="string"}}
		</div>
		<h5 class="gap">Then set</h5>
		{{> cols list=setcols n="cols"}}
		<h5 class="gap">And delete</h5>
		<input name="delcols" placeholder="columns, comma separated" aria-label="Columns to delete">
		<div class="cc-row gap">
			<label class="check"><input type="checkbox" role="switch" name="delrow">Delete the whole row instead</label>
		</div>
		<footer><button type="submit"><span class="material-icons">rule</span>Apply</button></footer>
	</form>
</article>
