<h5>Row keys</h5>
<div class="fields">
	<div><label>Prefix</label><input name="prefix" value="{{form.prefix}}" placeholder="2026-11-"></div>
	<div><label>From (inclusive)</label><input name="from" value="{{form.from}}"></div>
	<div><label>To (exclusive)</label><input name="to" value="{{form.to}}"></div>
	<div><label>Limit</label><input type="number" min="0" name="limit" value="{{form.limit}}" placeholder="no limit"></div>
</div>
<div class="cc-row gap">
	<label class="check"><input type="checkbox" role="switch" name="reverse"{{#if (eq form.reverse 'on')}} checked{{/if}}>Descending key order</label>
</div>
<h5 class="gap">Where</h5>
<div class="pred-row head"><small>Column</small><small>Comparison</small><small>Value</small><small>Type</small></div>
<div class="preds">
	{{#each where}}
	<div class="pred-row">
		<input name="where[{{@index}}][column]" value="{{column}}" placeholder="column" aria-label="Column" list="colnames">
		{{> cmpsel n=(concat 'where[' @index '][cmp]') o=cmp}}
		<input name="where[{{@index}}][value]" value="{{value}}" placeholder="value" aria-label="Value">
		{{> typesel n=(concat 'where[' @index '][type]') t=type}}
	</div>
	{{/each}}
</div>
<button type="button" class="ghost" data-add><span class="material-icons">add</span>Condition</button>
<small class="hint">Every condition must hold. A cell of another type than the value never matches; exists and missing ignore the value.</small>
