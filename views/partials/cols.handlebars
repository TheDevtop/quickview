<div class="cols">
	{{#each list}}
	<div class="cell-row">
		<input name="{{concat ../n '[' @index '][name]'}}" placeholder="column" aria-label="Column">
		<input name="{{concat ../n '[' @index '][value]'}}" placeholder="value" aria-label="Value">
		{{> typesel n=(concat ../n '[' @index '][type]') t=type}}
	</div>
	{{/each}}
</div>
<button type="button" class="ghost" data-add><span class="material-icons">add</span>Column</button>
